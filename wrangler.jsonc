{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "account_id": "aecab567d649bdcf9291f8f516264a3a",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {
    "NUXT_SITE_TOKEN": "m1Vzkw_OxLuxEKnPE7vQ7olS5PztzN2_VujXAG2Luuw",
    "NUXT_CF_ACCOUNT_ID": "aecab567d649bdcf9291f8f516264a3a",
    "NUXT_DATASET": "sink"
  },
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Values marked with DEPLOY_* below are placeholders for local/dev.
  // CLI deploy (pnpm deploy:worker / deploy:config) rewrites them into gitignored wrangler.deploy.jsonc.
  // Prefer setting DEPLOY_* in .env or Workers Builds / Pages variables — do not hardcode production IDs here.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "6c2336644d994c2f856ca340c2149205", // Override with DEPLOY_KV_PREVIEW_NAMESPACE_ID (falls back to DEPLOY_KV_NAMESPACE_ID)
      "id": "6c2336644d994c2f856ca340c2149205" // Override with DEPLOY_KV_NAMESPACE_ID
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink-db", // Override with DEPLOY_D1_DATABASE_NAME (default: sink)
      "database_id": "dda8a2ea-8a1e-4357-9d7a-4e58719dbf12", // Override with DEPLOY_D1_DATABASE_ID (required for CLI deploy)
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      // preview_bucket_name: DEPLOY_R2_PREVIEW_BUCKET_NAME (falls back to DEPLOY_R2_BUCKET_NAME)
      // omit DEPLOY_R2_BUCKET_NAME to drop R2 from generated deploy config
      "preview_bucket_name": "sink",
      "bucket_name": "sink" // Override with DEPLOY_R2_BUCKET_NAME
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"] // Run backup task daily at 00:00 UTC
  }
}
